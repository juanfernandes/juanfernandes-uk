{% set titleKey = page.url | replace('/', '') %}
{% if page.url == '/' %}
  {% set titleKey = 'home' %}
{% endif %}

{% set socialImageTitle = site.titles[titleKey] or title %}

{% if tag %}
  {% set socialImageTitle = 'Tag: ' + tag %}
{% endif %}

{% socialImage socialImageTitle, site.url, ogImage, ogImageAlt %}
